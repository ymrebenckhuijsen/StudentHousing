@page
@model StudentHousing.Pages.TakenModel
@{
    ViewData["Title"] = "Schoonmaaktaken";
}

<h1>Schoonmaaktaken</h1>

<table class="table">
    <thead>
    <tr>
        <th>Taak</th>
        <th>Ruimte</th>
        <th>Verantwoordelijke</th>
        <th>Deadline</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var taak in Model.Taken)
    {
        <tr>
            <td>@taak.Omschrijving</td>
            <td>@taak.Ruimte</td>
            <td>@taak.Verantwoordelijke</td>
            <td>@taak.Deadline.ToString("d-M-yyyy")</td>
            <td>@taak.Status</td>
        </tr>
    }
    </tbody>
</table>